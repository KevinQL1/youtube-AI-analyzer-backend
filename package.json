{
  "name": "youtube-growth-analyzer",
  "version": "1.0.0",
  "description": "AI-powered YouTube channel analytics and growth platform",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test:db": "node src/test-db.js",
    "test": "node --test"
  },
  "imports": {
    "#jobs/*": "./src/jobs/*.js",
    "#config/*": "./src/config/*.js",
    "#db/*": "./src/db/*.js",
    "#clients/*": "./src/clients/*.js",
    "#services/*": "./src/services/*.js",
    "#controllers/*": "./src/controllers/*.js",
    "#routes/*": "./src/routes/*.js",
    "#utils/*": "./src/utils/*.js"
  },
  "keywords": [
    "youtube",
    "analytics",
    "youtube-api",
    "growth",
    "ai"
  ],
  "author": "Kevin Quintero",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^176.0.0",
    "groq-sdk": "^1.5.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
